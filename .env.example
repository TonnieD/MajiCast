# ── Local Docker (docker compose) ─────────────────────────────────────────────
# Your machine's LAN IP — used to bake the backend URL into the Next.js bundle
# Find with: ipconfig (Windows) or ip addr (Linux/macOS)
HOST_IP=192.168.x.x

# ── Shared (local + production) ────────────────────────────────────────────────
# URL the browser uses to call the FastAPI backend
# Local:      http://<HOST_IP>:8000
# Production: https://<your-service>.railway.app
NEXT_PUBLIC_INFERENCE_API_URL=https://your-backend.railway.app

# Gemini API key for NLP features
GEMINI_API_KEY=your-gemini-api-key-here
