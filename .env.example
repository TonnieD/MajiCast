# ── Local Development / Decoupled Deployment ─────────────────────────────────────────
# When running frontend (npm run dev) and backend (uvicorn) separately locally:
# - NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
# - INFERENCE_API_URL=http://localhost:8000
#
# When deploying:
# - Set NEXT_PUBLIC_INFERENCE_API_URL to your Render web service URL (e.g. https://majicast-inference.onrender.com)
#
NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
INFERENCE_API_URL=http://localhost:8000

# Gemini API key for NLP features (server-side only — never exposed to browser)
GEMINI_API_KEY=your-gemini-api-key-here
