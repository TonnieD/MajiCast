# ── Local Development / Vercel Services ─────────────────────────────────────────
# When deploying to Vercel with the Services pack:
# - NEXT_PUBLIC_INFERENCE_API_URL should be set to /api-inference (relative path)
# - INFERENCE_API_URL should be set to /api-inference (relative path)
#
# When running frontend (npm run dev) and backend (uvicorn) separately:
# - NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
# - INFERENCE_API_URL=http://localhost:8000
#
NEXT_PUBLIC_INFERENCE_API_URL=/api-inference
INFERENCE_API_URL=/api-inference

# Gemini API key for NLP features (server-side only — never exposed to browser)
GEMINI_API_KEY=your-gemini-api-key-here
