# ── Local Development / Vercel Services ─────────────────────────────────────────
# By default, MajiCast routes inference traffic using the Vercel multi-service
# routing prefix: /_/backend.
#
# When running frontend (npm run dev) and backend (uvicorn) separately (without vercel dev):
# - NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
# - INFERENCE_API_URL=http://localhost:8000
#
# Leave these commented out or blank on Vercel so the relative /_/backend prefix is used:
# NEXT_PUBLIC_INFERENCE_API_URL=
# INFERENCE_API_URL=

# Gemini API key for NLP features (server-side only — never exposed to browser)
GEMINI_API_KEY=your-gemini-api-key-here
