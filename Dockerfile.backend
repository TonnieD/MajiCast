# Use an official Python runtime as a parent image
FROM python:3.12-slim

# Set the working directory
WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY inference/requirements.txt ./inference/requirements.txt
RUN pip install --no-cache-dir -r inference/requirements.txt

# Copy the backend code and trained model pickles
COPY inference/ ./inference
COPY app/models/ ./app/models

# Expose port 8000
EXPOSE 8000

# Run uvicorn — Railway injects $PORT; local Docker defaults to 8000
CMD ["sh", "-c", "uvicorn inference.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
